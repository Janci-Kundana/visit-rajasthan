# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python bytecode from the Blender scripts
__pycache__/
*.pyc

# Blender intermediates. The .glb files the site actually loads are committed
# under public/models/; blender-output/models/ holds superseded builds from an
# earlier iteration that nothing references.
blender-output/models/
blender-output/scenes/
blender-output/*.glb
output/playwright/
.playwright-cli/

# TypeScript incremental build state
tsconfig.tsbuildinfo

# Hook run artefacts
.claude/logs/
tests/.tmp/
